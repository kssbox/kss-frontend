{
  "name": "@kssbox/ui",
  "version": "0.1.0",
  "private": false,
  "description": "Kssbox reusable shadcn-style React UI component library.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm run lint && pnpm run build"
  },
  "keywords": [
    "react",
    "components",
    "ui-library",
    "tailwindcss",
    "shadcn"
  ],
  "author": "Kevin brother",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kssbox/kss-frontend.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/kssbox/kss-frontend/issues"
  },
  "homepage": "https://github.com/kssbox/kss-frontend/tree/main/packages/ui#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
