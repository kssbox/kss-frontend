{
  "name": "kss-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Kssbox frontend base packages.",
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "pre-commit": "lint-staged",
    "reset": "pnpm run clean && rm -rf node_modules **/node_modules && pnpm install"
  },
  "keywords": [],
  "author": "Kevin brother",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "catalog:",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.20.6",
    "turbo": "^2.0.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.12.3",
  "lint-staged": {
    "packages/**/*.{mjs,cjs,tsx,ts}": "eslint"
  }
}
